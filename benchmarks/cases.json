  "cases": [
    {
      "name": "vulnerable-support-bot",
      "spec": {
        "name": "support-agent",
        "description": "A customer support agent with email and web input, a shared knowledge base, and tools that can refund payments.",
        "inputs": [
          {
            "source": "user",
            "trusted": false
          },
          {
            "source": "email",
            "trusted": false
          },
          {
            "source": "web",
            "trusted": false
          },
          {
            "source": "tool_output",
            "trusted": true
          }
        ],
        "tools": [
          {
            "name": "ticket_db",
            "capabilities": [
              "read",
              "write",
              "database"
            ],
            "requires_approval": false,
            "sandboxed": false,
            "authenticated": false
          },
          {
            "name": "refund_tool",
            "capabilities": [
              "payment",
              "network"
            ],
            "requires_approval": false,
            "sandboxed": false,
            "authenticated": true
          },
          {
            "name": "send_email",
            "capabilities": [
              "send_message",
              "network"
            ],
            "requires_approval": false,
            "sandboxed": false,
            "authenticated": true
          }
        ],
        "data": [
          {
            "name": "customer_records",
            "sensitivity": "pii",
            "encrypted": false
          },
          {
            "name": "billing_data",
            "sensitivity": "confidential",
            "encrypted": false
          }
        ],
        "memory": {
          "type": "persistent",
          "shared_across_users": true,
          "writes_from_untrusted_input": true
        },
        "outputs": [
          "user",
          "email",
          "api_call"
        ],
        "credentials": {
          "scope": "long_lived_broad",
          "stored_in": "prompt"
        },
        "mcp_servers": [
          {
            "name": "crm-mcp",
            "audited": false,
            "authenticated": false,
            "network_exposed": true
          }
        ],
        "agents": {
          "count": 3,
          "per_agent_identity": false,
          "subagents_inherit_credentials": true
        },
        "controls": {
          "input_guard": false,
          "output_validation": false,
          "audit_logging": false,
          "audit_log_redaction": false,
          "policy_enforcement": false,
          "human_approval_for_writes": false,
          "rate_limits": false,
          "kill_switch": false,
          "inventory_tracked": false
        }
